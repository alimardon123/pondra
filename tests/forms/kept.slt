# 1.1's statements, refused by name at every form, in the same words (src/kept.rs): pipelines, dashboards, connections
# the grants on them, GRANT EXECUTE, and a pipeline's STEP, PARALLEL and WAIT FOR. The words that are also names still
# work: a table called pipeline, dashboard or connection, and a prepared statement called pipeline.
statement error 0A000 1\.1
CREATE PIPELINE p AS BEGIN STEP a AS SELECT 1; END

statement error 0A000 1\.1
CREATE OR REPLACE PIPELINE p AS BEGIN STEP a AS SELECT 1; END

statement error 0A000 1\.1
ALTER PIPELINE p SUSPEND

statement error 0A000 1\.1
DROP PIPELINE p

statement error 0A000 1\.1
SHOW CREATE PIPELINE p

statement error 0A000 1\.1
SHOW PIPELINES

statement error 0A000 1\.1
EXPLAIN PIPELINE p

statement error 0A000 1\.1
COMMENT ON PIPELINE p IS 'x'

statement error 0A000 1\.1
EXECUTE PIPELINE p

statement error 0A000 1\.1
