# A transaction: COMMIT keeps its writes, ROLLBACK leaves nothing. (Its writes keep a table's rules as a statement's
# do: keys.slt and identity.slt, form-parity D3.)
statement ok
CREATE TABLE a (id INT, v TEXT)

statement ok
BEGIN

statement ok
INSERT INTO a VALUES (1, 'x')

statement ok
COMMIT

statement ok
BEGIN

statement ok
INSERT INTO a VALUES (2, 'gone')

statement ok
UPDATE a SET v = 'gone too'

statement ok
ROLLBACK

query IT
SELECT id, v FROM a ORDER BY id
----
1 x
