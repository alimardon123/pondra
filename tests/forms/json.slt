# Postgres's JSON at every form: operators, makers and set-returning functions (form-parity P4).
query T
SELECT '{"a": {"b": 2}}'::jsonb -> 'a' ->> 'b'
----
2

query T
SELECT jsonb_build_object('k', 1, 'l', 'x')::text
----
{"k": 1, "l": "x"}

query T rowsort
SELECT value::text FROM jsonb_array_elements('[1, "two", null]'::jsonb)
----
"two"
1
null

query T rowsort
SELECT key FROM jsonb_each('{"x": 1, "y": 2}'::jsonb)
----
x
y

query T
SELECT pg_typeof('{}'::jsonb)
----
jsonb

query T
SELECT '{"b": 1, "a": 2}'::jsonb::text
----
{"a": 2, "b": 1}

query TT
SELECT key, value FROM json_each_text('{"a": "x", "b": "y"}') ORDER BY key
----
a x
b y

statement ok
CREATE TABLE o (id INT, name TEXT)

statement ok
INSERT INTO o VALUES (1, 'a')

query T
SELECT to_json(o)::text FROM o
----
{"id":1,"name":"a"}

statement ok
CREATE TABLE held_j (id INT, d JSONB)

statement ok
INSERT INTO held_j VALUES (1, '{"b":1,"a":2}'), (2, '[1,  2]')

query IT rowsort
SELECT id, d::text FROM held_j
----
1 {"a": 2, "b": 1}
2 [1, 2]

statement ok
UPDATE held_j SET d = '{"z": 0, "y":[3]}' WHERE id = 2

query T
SELECT d::text FROM held_j WHERE id = 2
----
{"y": [3], "z": 0}

query I
SELECT count(DISTINCT d::text) FROM (SELECT d FROM held_j WHERE id = 1 UNION ALL SELECT '{"a": 2, "b": 1}'::jsonb) x
----
1
