# UPDATE, DELETE and MERGE change the rows they name, and answer how many (form-parity P2).
statement ok
CREATE TABLE t (id INT, v INT)

statement ok
INSERT INTO t VALUES (1, 10), (2, 20), (3, 30)

statement count 1
UPDATE t SET v = v + 1 WHERE id = 2

statement count 1
DELETE FROM t WHERE id = 3

statement ok
CREATE TABLE s (id INT, v INT)

statement ok
INSERT INTO s VALUES (1, 100), (4, 400)

statement ok
MERGE INTO t USING s ON t.id = s.id WHEN MATCHED THEN UPDATE SET v = s.v WHEN NOT MATCHED THEN INSERT VALUES (s.id, s.v)

query II
SELECT id, v FROM t ORDER BY id
