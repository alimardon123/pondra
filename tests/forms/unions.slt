query I
SELECT count(*) AS n FROM (SELECT x FROM (SELECT x FROM u WHERE x > 0 UNION ALL SELECT x FROM u WHERE x > 0) LIMIT 3)
----
3

query I
SELECT count(*) AS n FROM u JOIN (SELECT x FROM u WHERE x > 0 UNION ALL SELECT x FROM u WHERE x > 0) v ON u.x = v.x
----
4
