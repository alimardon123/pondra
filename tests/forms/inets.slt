# INET (IPADDRESS inside), Postgres's inet and DuckDB's INET: one IPv4 or IPv6 address, held in 17 bytes (FixedSizeBinary(17):
# its family, then IPv4 mapped into IPv6), so it compares, sorts, groups and joins by its bytes, every IPv4 address before
# every IPv6 one, as Postgres and DuckDB sort them, and an IPv4-mapped IPv6 address apart from its IPv4 one. It is
# shown as Postgres shows a host, and SHOW CREATE says INET. A string beside one is read as one; one that isn't an address is
# refused in Postgres's words (22P02), and a network (CIDR) waits for its own type (0A000).
statement ok
CREATE TABLE hosts (id INT, ip INET)

statement ok
INSERT INTO hosts VALUES (1, '10.0.0.1'), (2, '2001:DB8::1'), (3, '10.0.0.2/32'), (4, NULL), (5, '::ffff:192.168.1.1')

query IT rowsort
SELECT id, ip FROM hosts
----
1 10.0.0.1
2 2001:db8::1
3 10.0.0.2
4 NULL
5 ::ffff:192.168.1.1

query T
SELECT arrow_typeof(ip) FROM hosts WHERE id = 1
----
FixedSizeBinary(17)

query I
SELECT id FROM hosts WHERE ip = '10.0.0.2'
----
3

query I rowsort
SELECT id FROM hosts WHERE ip IN ('10.0.0.1', '2001:db8:0::1')
----
1
2

query I rowsort
SELECT id FROM hosts WHERE ip BETWEEN '10.0.0.0' AND '10.0.0.255'
----
1
3

query IB rowsort
SELECT id, ip = '10.0.0.1' FROM hosts WHERE id < 3
----
1 true
2 false

query I
SELECT id FROM hosts WHERE ip IS NOT NULL ORDER BY ip
----
1
3
5
2

# Every IPv4 address before every IPv6 one, and a mapped address apart from its IPv4 one, as Postgres has them
query BBB
SELECT '10.0.0.1'::inet < '::1'::inet, '255.255.255.255'::inet < '::'::inet, '::ffff:1.2.3.4'::inet = '1.2.3.4'::inet
----
true true false

query T
SELECT ip::text FROM hosts WHERE id = 2
----
2001:db8::1

query T
SELECT '10.1.2.3'::inet
----
10.1.2.3

query T
SELECT CAST(t AS INET) FROM (VALUES ('::1')) AS v(t)
----
::1

query T
SELECT TRY_CAST(t AS INET) FROM (VALUES ('x')) AS v(t)
----
NULL

statement error 22P02 invalid input syntax for type inet: "10\.0\.0\.256"
INSERT INTO hosts VALUES (6, '10.0.0.256')

statement error 0A000 a network comes with CIDR
INSERT INTO hosts VALUES (6, '10.0.0.0/8')

query error 22P02 invalid input syntax for type inet: "nope"
SELECT 'nope'::inet

query error 22P02 invalid input syntax for type inet: "nope"
SELECT id FROM hosts WHERE ip = 'nope'

# A table of them joins by address, groups by one, and takes another column of the type
statement ok
CREATE TABLE seen (ip INET, n INT)

statement ok
INSERT INTO seen VALUES ('10.0.0.1', 5), ('2001:db8::1', 7), ('10.0.0.1', 1)

query TI rowsort
SELECT ip, sum(n) FROM seen GROUP BY ip
----
10.0.0.1 6
2001:db8::1 7

query II rowsort
SELECT h.id, s.n FROM hosts h JOIN seen s ON h.ip = s.ip
----
1 1
1 5
2 7

statement ok
ALTER TABLE hosts ADD COLUMN gw INET

statement ok
INSERT INTO hosts (id, ip, gw) VALUES (7, '10.0.0.7', '10.0.0.254')

query TT
SELECT ip, gw FROM hosts WHERE id = 7
----
10.0.0.7 10.0.0.254

query T
SELECT replace(definition, chr(10), ' ') FROM pondra.objects WHERE name = 'hosts'
----
CREATE TABLE hosts ( id INT, ip INET, gw INET )

# An UPDATE's string is read as one, and CREATE TABLE … AS keeps the type
statement ok
UPDATE hosts SET ip = '10.0.0.9' WHERE id = 1

query T
SELECT ip FROM hosts WHERE id = 1
----
10.0.0.9

statement ok
CREATE TABLE kept AS SELECT id, ip FROM hosts WHERE id IN (1, 2)

query IT rowsort
SELECT id, ip FROM kept WHERE ip <> '::2'
----
1 10.0.0.9
2 2001:db8::1

query T
SELECT replace(definition, chr(10), ' ') FROM pondra.objects WHERE name = 'kept'
----
CREATE TABLE kept ( id INT, ip INET )

# A keyed table's UPDATE, and an INSERT … SELECT of text, read strings as one too
statement ok
CREATE TABLE leases (k INT PRIMARY KEY, ip INET)

statement ok
INSERT INTO leases VALUES (1, '10.0.0.1'), (2, '10.0.0.2')

statement ok
UPDATE leases SET ip = '10.0.0.11' WHERE k = 1

statement ok
INSERT INTO leases SELECT k, t FROM (VALUES (3, '::3')) AS v(k, t)

query IT
SELECT k, ip FROM leases ORDER BY k
----
1 10.0.0.11
2 10.0.0.2
3 ::3
