# Postgres's casts and type functions at every form: uuid, arrays, pg_typeof, a lateral series, an enum's refusal
# (form-parity §2: the front runs these passes on every form, `pg_casts::rewrite`).
query T
SELECT 'A0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11'::uuid::text
----
a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11

statement error 22P02
SELECT CAST('nope' AS UUID)

query T
SELECT pg_typeof(gen_random_uuid())
----
uuid

query T
SELECT pg_typeof(1)
----
bigint

query T
SELECT '{a,b}'::text[]
----
[a, b]

statement ok
CREATE TABLE s (id INT, qty INT)

statement ok
INSERT INTO s VALUES (1, 2), (2, 3)

query I
SELECT count(*) FROM s, generate_series(1, s.qty) g
----
5

statement error 42704
SELECT enum_range(NULL::mood)

# NaN is Postgres's numeric value; a decimal column here holds numbers only, so a NaN written into one is refused by name
# (0A000) where the write casts it (`casts::into`: a text or float value of a table or file). Where the planner casts it (a
# page's INSERT, a literal it folds) the code is the same, with the planner's words.
statement ok
CREATE TABLE money (v NUMERIC(5, 2))

statement ok
CREATE TABLE raw (v VARCHAR)

statement ok
INSERT INTO raw VALUES ('NaN')

statement error 0A000
INSERT INTO money SELECT v FROM raw

statement error 22003
INSERT INTO money VALUES ('1000')
