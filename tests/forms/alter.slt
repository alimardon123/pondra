# ALTER TABLE and TRUNCATE: a column added is NULL in the rows there, a rename and a drop take the table's rules along
# (its key, its UNIQUE and its CHECKs), and the refusals are a node's (designs/l2-page-ddl.md D2).
statement ok
CREATE TABLE at1 (id INT PRIMARY KEY, name VARCHAR(5), n INT CHECK (n > 0), u INT UNIQUE)

statement ok
INSERT INTO at1 VALUES (1, 'a', 1, 10), (2, 'b', 2, 20)

statement ok
ALTER TABLE at1 ADD COLUMN w INT

query ITIII
SELECT id, name, n, u, w FROM at1 ORDER BY id
----
1 a 1 10 NULL
2 b 2 20 NULL

statement ok
ALTER TABLE at1 ADD COLUMN IF NOT EXISTS w INT

